  "query": "\n        SELECT u.name AS provider_name,\n               u.profile_pic,\n               s.id,\n               s.categories,\n               s.name AS service_name,\n               s.description,\n               s.image\n          FROM services s\n          JOIN users u ON u.cpf_cnpj = s.provider_key\n        ",
